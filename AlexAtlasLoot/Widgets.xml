	<!-- The rows and tiles of the guide. Every piece of art here is the client's own
	     Adventure Guide art, declared in Art.xml. Sizes match the originals so the
	     parchment and the frames line up with their textures pixel for pixel. -->

	<!-- One dungeon or raid on the home page. -->
	<Button name="AlexAGInstanceTileTemplate" virtual="true">
		<Size x="174" y="96"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Background">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<TexCoords left="0" right="0.68359375" top="0" bottom="0.7421875"/>
				</Texture>
				<!-- The same picture again, added on top of itself. The painted scenes are
				     dark by nature and a texture cannot be told to draw brighter than it
				     is, so it is laid over itself to lift the light parts. -->
				<Texture parentKey="Lift" alphaMode="ADD" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BACKGROUND" textureSubLevel="1">
				<!-- Two narrow shades, one under the name and one under the level line,
				     each fading into nothing. The middle of the picture stays clear, which
				     a wash over the whole card does not allow. -->
				<Texture parentKey="ScrimTop" hidden="true">
					<Size x="0" y="46"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
				</Texture>
				<Texture parentKey="ScrimBottom" hidden="true">
					<Size x="0" y="34"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Name" inherits="QuestTitleFontBlackShadow">
					<Size x="150" y="0"/>
					<Anchors>
						<Anchor point="TOP" x="0" y="-15"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Range" inherits="GameFontNormalSmall" justifyH="LEFT">
					<Size x="100" y="12"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="9" y="9"/>
					</Anchors>
				</FontString>
				<FontString parentKey="Bosses" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Size x="60" y="12"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-9" y="9"/>
					</Anchors>
				</FontString>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="1">
				<!-- The Forever crest, bottom centre, on the instances Forever added itself. -->
				<Texture parentKey="ForeverMark" file="Interface\AddOns\AlexAtlasLoot\Textures\forever.png" hidden="true">
					<Size x="26" y="26"/>
					<Anchors>
						<Anchor point="BOTTOM" x="0" y="4"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<NormalTexture inherits="AG-UI-EJ-DungeonButton-Up"/>
		<PushedTexture inherits="AG-UI-EJ-DungeonButton-Down"/>
		<HighlightTexture inherits="AG-UI-EJ-DungeonButton-Highlight"/>
	</Button>

	<!-- One boss on the left page of an instance. -->
	<Button name="AlexAGBossRowTemplate" virtual="true">
		<Size x="325" y="55"/>
		<Layers>
			<!-- On the dark page the button art is switched off and the row is a quiet card
			     with a gold bar down its left edge when selected. -->
			<Layer level="BORDER">
				<Texture parentKey="Card" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="0" y="0"/>
						<Anchor point="BOTTOMRIGHT" x="0" y="0"/>
					</Anchors>
				</Texture>
				<!-- A hairline frame round the selected row, one pixel thick. A plate with
				     edges reads as chosen without shouting; a fat bar down one side does
				     not belong to a book. -->
				<Texture parentKey="EdgeTop" hidden="true">
					<Size x="0" y="1"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="1" y="-1"/>
						<Anchor point="TOPRIGHT" x="-1" y="-1"/>
					</Anchors>
				</Texture>
				<Texture parentKey="EdgeBottom" hidden="true">
					<Size x="0" y="1"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" x="1" y="1"/>
						<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
					</Anchors>
				</Texture>
				<Texture parentKey="EdgeLeft" hidden="true">
					<Size x="1" y="0"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="1" y="-1"/>
						<Anchor point="BOTTOMLEFT" x="1" y="1"/>
					</Anchors>
				</Texture>
				<Texture parentKey="EdgeRight" hidden="true">
					<Size x="1" y="0"/>
					<Anchors>
						<Anchor point="TOPRIGHT" x="-1" y="-1"/>
						<Anchor point="BOTTOMRIGHT" x="-1" y="1"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="5">
				<Texture parentKey="FaceRing" hidden="true">
					<Size x="54" y="54"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent" relativePoint="LEFT" x="42" y="0"/>
					</Anchors>
				</Texture>
				<MaskTexture parentKey="FaceRingMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="54" y="54"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.FaceRing" relativePoint="CENTER"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="FaceRing"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="6">
				<Texture parentKey="Portrait" file="Interface\EncounterJournal\UI-EJ-BOSS-Default">
					<Size x="128" y="64"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="-4" y="13"/>
					</Anchors>
				</Texture>
			</Layer>
			<!-- The selected boss keeps the warm light the row shows under the mouse. The
			     light in the sheet ends a few pixels short of the bar it sits on, fine for a
			     flicker under the mouse, visible when it stays, so it is pulled out to the
			     bar's own end. -->
			<Layer level="ARTWORK">
				<Texture parentKey="Glow" inherits="AG-UI-EJ-BossButton-Highlight" alphaMode="ADD" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="0" y="0"/>
						<Anchor point="BOTTOMRIGHT" x="8" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY" textureSubLevel="7">
				<FontString parentKey="Level" inherits="GameFontDisableSmall" justifyH="RIGHT">
					<Size x="60" y="12"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" x="-26" y="12"/>
					</Anchors>
				</FontString>
			</Layer>
			<!-- The game fills this slot with a painted bust it keeps per boss. There is no
			     such picture here, but AtlasLoot stores the creature's display id, and the
			     client can paint a portrait from that, the same way the guide's own search
			     results do. The button art carries a dark medallion at its left edge, centred
			     42 pixels in; the portrait sits inside it, a hair smaller, so the dark rim
			     shows around the face. The mask is a child texture rather than a call to
			     SetMask, because painting the portrait afterwards drops a mask set that way. -->
			<Layer level="OVERLAY" textureSubLevel="6">
				<!-- Where the creature has no model, the circle holds a dimmed grey icon
				     from the game instead: the question mark it uses for anything unknown,
				     or crossed blades for a pack of trash. The fill behind it keeps the
				     disc solid so the icon does not float on the page. -->
				<Texture parentKey="FaceFill" hidden="true">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent" relativePoint="LEFT" x="42" y="0"/>
					</Anchors>
				</Texture>
				<Texture parentKey="Face" hidden="true">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent" relativePoint="LEFT" x="42" y="0"/>
					</Anchors>
				</Texture>
				<MaskTexture parentKey="FaceMask" file="Interface\CharacterFrame\TempPortraitAlphaMask" hWrapMode="CLAMPTOBLACKADDITIVE" vWrapMode="CLAMPTOBLACKADDITIVE">
					<Size x="48" y="48"/>
					<Anchors>
						<Anchor point="CENTER" relativeKey="$parent.Face" relativePoint="CENTER"/>
					</Anchors>
					<MaskedTextures>
						<MaskedTexture childKey="Face"/>
						<MaskedTexture childKey="FaceFill"/>
					</MaskedTextures>
				</MaskTexture>
			</Layer>
		</Layers>
		<NormalTexture inherits="AG-UI-EJ-BossButton-Up"/>
		<PushedTexture inherits="AG-UI-EJ-BossButton-Down"/>
		<HighlightTexture inherits="AG-UI-EJ-BossButton-Highlight"/>
		<ButtonText parentKey="Text" justifyH="LEFT" justifyV="MIDDLE">
			<Size x="160" y="40"/>
			<Anchors>
				<Anchor point="LEFT" x="105" y="-3"/>
			</Anchors>
			<Color r="0.827" g="0.659" b="0.463"/>
		</ButtonText>
		<NormalFont style="GameFontNormalMed3"/>
		<HighlightFont style="GameFontNormalMed3"/>
	</Button>

	<!-- One item on the right page. The two parchment strips are the client's own: the
	     short one for a single boss, the tall one when the row also names its boss. -->
	<Button name="AlexAGLootRowTemplate" virtual="true" registerForClicks="LeftButtonUp, RightButtonUp">
		<Size x="321" y="45"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Icon">
					<Size x="42" y="42"/>
					<Anchors>
						<Anchor point="TOPLEFT" x="2" y="-2"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<!-- Used instead of the parchment strips on the dark page. -->
				<Texture parentKey="Card" hidden="true">
					<Anchors>
						<Anchor point="TOPLEFT" x="0" y="0"/>
						<Anchor point="BOTTOMRIGHT" x="0" y="2"/>
					</Anchors>
				</Texture>
				<Texture parentKey="ShortFrame" inherits="AG-UI-EJ-LootFrame">
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
				<!-- The tall strip is 369 by 64 in the sheet. It is narrowed to the width of
				     the short one so it does not run into the scroll bar, and keeps its full
				     height so the boss line below the icon has room, exactly as in the game. -->
				<Texture parentKey="TallFrame" inherits="AG-UI-EJ-DungeonLootFrame" hidden="true">
					<Size x="321" y="64"/>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
				</Texture>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Name" inherits="GameFontNormalMed3" justifyH="LEFT">
					<Size x="250" y="12"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="TOPRIGHT" x="7" y="-7"/>
					</Anchors>
				</FontString>
				<FontString parentKey="ArmorType" inherits="GameFontBlack" justifyH="RIGHT">
					<Size x="0" y="12"/>
					<Anchors>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.Name" relativePoint="TOPLEFT" x="264" y="-30"/>
					</Anchors>
					<Color r="0.25" g="0.1484375" b="0.02"/>
				</FontString>
				<FontString parentKey="Slot" inherits="GameFontBlack" justifyH="LEFT">
					<Size x="0" y="12"/>
					<Anchors>
						<Anchor point="BOTTOMLEFT" relativeKey="$parent.Icon" relativePoint="BOTTOMRIGHT" x="7" y="5"/>
						<Anchor point="BOTTOMRIGHT" relativeKey="$parent.ArmorType" relativePoint="BOTTOMLEFT" x="-15" y="0"/>
					</Anchors>
					<Color r="0.25" g="0.1484375" b="0.02"/>
				</FontString>
				<FontString parentKey="Boss" inherits="GameFontBlack" justifyH="LEFT" hidden="true">
					<Size x="250" y="12"/>
					<Anchors>
						<Anchor point="TOPLEFT" relativeKey="$parent.Icon" relativePoint="BOTTOMLEFT" x="0" y="-3"/>
					</Anchors>
					<Color r="0.25" g="0.1484375" b="0.02"/>
				</FontString>
			</Layer>
		</Layers>
	</Button>

	<!-- The tabs down the right edge of the book. -->
	<Button name="AlexAGSideTabTemplate" virtual="true">
		<Size x="63" y="57"/>
		<Layers>
			<Layer level="OVERLAY">
				<Texture parentKey="Icon">
					<Size x="48" y="43"/>
					<Anchors>
						<Anchor point="CENTER" x="6" y="0"/>
					</Anchors>
				</Texture>
			</Layer>
		</Layers>
		<NormalTexture inherits="AG-UI-EJ-Tab-UnSelected"/>
		<PushedTexture inherits="AG-UI-EJ-Tab-Selected"/>
		<HighlightTexture inherits="AG-UI-EJ-Tab-Highlight" alphaMode="ADD"/>
	</Button>
</Ui>
